{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres_ods": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/mcp-postgres.ps1",
        "ODS"
      ],
      "enabled": true
    },
    "postgres_dds": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/mcp-postgres.ps1",
        "DDS"
      ],
      "enabled": true
    },
    "postgres_dm": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/mcp-postgres.ps1",
        "DM"
      ],
      "enabled": true
    }
  }
}